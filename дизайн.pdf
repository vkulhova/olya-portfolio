352 0 obj
  << /ActualText (My name is Olika\054 and my art lives under Lolikar\056 I make warm\054 cozy\054 detailed illustrations\054 mainly children\031s book art\054 character design\054 and custom portraits\056 Every piece is meant to feel like a small world you\031d want to step into\054 filled with little objects\054 cozy homes\054 and characters that feel lived in\056 I have a love for small details\054 vintage aesthetics\054 and soft textures that reward a second look\056)
     /K [ 3 ]
     /P 353 0 R
     /Pg 346 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

